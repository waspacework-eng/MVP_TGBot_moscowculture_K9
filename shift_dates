"""
Сдвиг дат в events.json так, чтобы все события были в будущем.
Запуск:  python shift_dates.py events.json 2026-11-09
Результат: events_shifted.json (исходный файл НЕ перезаписывается).

Сдвиг кратен 7 дням, поэтому дни недели сохраняются
(субботний мастер-класс остаётся субботним).
Нужен ТОЛЬКО если база демонстрационная. Если события реальные —
даты надо обновлять по источникам, а не сдвигать.
"""
import json, sys
from datetime import datetime, timedelta

src = sys.argv[1] if len(sys.argv) > 1 else "events.json"
start = datetime.strptime(sys.argv[2] if len(sys.argv) > 2 else "2026-11-09", "%Y-%m-%d")

ev = json.load(open(src, encoding="utf-8"))
dates = [datetime.strptime(e["date"], "%Y-%m-%d") for e in ev]
first = min(dates)
shift_days = -(-(start - first).days // 7) * 7          # округление вверх до кратного 7
print(f"Событий: {len(ev)}; диапазон был {first:%Y-%m-%d}..{max(dates):%Y-%m-%d}; сдвиг {shift_days} дн.")

for e, d in zip(ev, dates):
    e["date"] = (d + timedelta(days=shift_days)).strftime("%Y-%m-%d")

json.dump(ev, open("events_shifted.json", "w", encoding="utf-8"), ensure_ascii=False, indent=2)
new = sorted(e["date"] for e in ev)
print(f"Стало: {new[0]}..{new[-1]}; на 09.11 и позже: {sum(d >= '2026-11-09' for d in new)}")

# Контроль полей
need = ["title", "date", "time", "location", "price", "link", "tags"]
bad = [i for i, e in enumerate(ev) if any(k not in e for k in need)]
print("Записей с пропущенными полями:", len(bad), bad[:10])
